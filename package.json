{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "renovate",
	"version": "1.0.0",
	"description": "Manage Renovate version",
	"author": {
		"name": "Nikolas Grottendieck",
		"email": "git@nikolasgrottendieck.com",
		"url": "https://nikolasgrottendieck.com"
	},
	"license": "MIT",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.22.2",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "error"
		}
	},
	"engineStrict": true,
	"scripts": {
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"renovate": "44.197.0"
	},
	"devDependencies": {}
}
